---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Issue from '../components/Issue.astro';
import { TAG_LABELS } from '../lib/site';
import { allTags } from '../../pipeline/sources';

const issues = (await getCollection('issues')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const latest = issues[0];
const older = issues.slice(1);

// Only tags that have appeared in a published Issue, so the home page never links to an empty page.
const usedTags = allTags().filter((tag) =>
  issues.some((i) => i.data.items.some((item) => item.tags.includes(tag))),
);
---

<Base description={latest?.data.intro ?? undefined}>
  {
    latest ? (
      <>
        <p class="muted">
          ฉบับล่าสุด · <a href={`/${latest.data.date}/`}>{latest.data.date}</a>
        </p>
        <Issue issue={latest} showDate={false} />
      </>
    ) : (
      /*
       * The honest pre-launch state. An archive with no Issues yet says so rather
       * than showing a stale one or an error — a gap must never look like a quiet day.
       */
      <>
        <h1>Daily Dev Brief</h1>
        <p class="empty">ยังไม่มีฉบับที่เผยแพร่</p>
        <p class="muted">
          เมื่อ Run แรกทำงานเสร็จ ฉบับแรกจะปรากฏที่นี่ พร้อมช่วงเวลาที่มันครอบคลุม
        </p>
      </>
    )
  }

  {
    usedTags.length > 0 && (
      <p class="tags">
        หัวข้อ: {usedTags.map((tag) => (
          <a href={`/tag/${tag}/`}>{TAG_LABELS[tag] ?? tag}</a>
        ))}
      </p>
    )
  }

  {
    older.length > 0 && (
      <p>
        <a href="/archive/">ฉบับก่อนหน้าทั้งหมด ({older.length})</a>
      </p>
    )
  }
</Base>

<style>
  .tags {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .tags a {
    margin-right: 0.6rem;
  }
</style>

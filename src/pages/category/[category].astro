---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORY_IDS, categoryById } from '../../lib/taxonomy';

export async function getStaticPaths() {
  return CATEGORY_IDS.map((id) => ({
    params: { category: id },
    props: { id },
  }));
}

const { id } = Astro.props;
const meta = categoryById(id)!;
const issues = (await getCollection('issues')).sort((a, b) =>
  a.data.date < b.data.date ? 1 : -1,
);
---

<Base title={meta.labelTh}>
  <p><a href="/">← ฉบับล่าสุด</a></p>
  <h1>{meta.labelTh}</h1>
  <p class="muted">{meta.labelEn}</p>

  <ul>
    {
      issues.map((issue) => (
        <li>
          <a href={`/${issue.data.date}/`}>{issue.data.date}</a>
        </li>
      ))
    }
  </ul>
</Base>

---
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE.title ? title : `${title} · ${SITE.title}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      Both preferences are applied before the first paint, inline and before any stylesheet
      matters. Reading them after load would show every returning reader a flash of the wrong
      theme, which is the whole cost of having the toggle.
    -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        try {
          const theme = localStorage.getItem('ddb-theme');
          el.dataset.theme =
            theme ??
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const width = localStorage.getItem('ddb-width');
          if (width) el.dataset.width = width;
        } catch {
          // Private mode, or storage disabled. The defaults are already correct.
          el.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <header>
      <a href="/" class="brand">{SITE.title}</a>
      <nav>
        <a href="/about/">เกี่ยวกับ</a>
        <a href="/archive/">ฉบับก่อนหน้า</a>
        <a href="/rss.xml">RSS</a>
        <button
          id="theme-toggle"
          type="button"
          class="toggle"
          title="สลับโหมดสว่าง/มืด"
          aria-label="สลับโหมดสว่าง/มืด"
        ></button>
        <!--
          The icon states what the click will do, not what is on now: a page at the reading
          width shows "expand", and a full-width page shows "collapse". Which one is visible
          is decided in CSS from `data-width`, so the button works before any script runs.
        -->
        <button
          id="width-toggle"
          type="button"
          class="toggle"
          title="ขยายเนื้อหาให้เต็มจอ"
          aria-label="ขยายเนื้อหาให้เต็มจอ"
          aria-pressed="false"
        >
          <svg
            class="icon icon-expand"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4"></path>
          </svg>
          <svg
            class="icon icon-collapse"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 6h4V2M14 6h-4V2M2 10h4v4M14 10h-4v4"></path>
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>สร้างโดย pipeline อัตโนมัติ · ทุกข้อกล่าวอ้างมีข้อความต้นทางและลิงก์กำกับ</p>
    </footer>

    <script is:inline>
      (() => {
        const el = document.documentElement;
        const themeButton = document.getElementById('theme-toggle');
        const widthButton = document.getElementById('width-toggle');

        const paint = () => {
          if (themeButton) {
            const dark = el.dataset.theme === 'dark';
            themeButton.textContent = dark ? '☀️' : '🌙';
            const label = dark ? 'สลับเป็นโหมดสว่าง' : 'สลับเป็นโหมดมืด';
            themeButton.title = label;
            themeButton.setAttribute('aria-label', label);
          }
          if (widthButton) {
            const wide = el.dataset.width === 'wide';
            // The icon is chosen in CSS; only the words a screen reader reads are set here.
            const label = wide ? 'ย่อเนื้อหากลับเป็นความกว้างอ่านสบาย' : 'ขยายเนื้อหาให้เต็มจอ';
            widthButton.title = label;
            widthButton.setAttribute('aria-label', label);
            widthButton.setAttribute('aria-pressed', String(wide));
          }
        };

        const save = (key, value) => {
          try {
            localStorage.setItem(key, value);
          } catch {
            // A preference that cannot be saved is still worth honouring for this page.
          }
        };

        themeButton?.addEventListener('click', () => {
          el.dataset.theme = el.dataset.theme === 'dark' ? 'light' : 'dark';
          save('ddb-theme', el.dataset.theme);
          paint();
        });

        widthButton?.addEventListener('click', () => {
          el.dataset.width = el.dataset.width === 'wide' ? 'normal' : 'wide';
          save('ddb-width', el.dataset.width);
          paint();
        });

        paint();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fg: #16181d;
    --muted: #6b7280;
    --border: #e5e7eb;
    --accent: #1f6feb;
    --bg: #ffffff;
    /* The reading measure. A toggle, because the right width depends on what a reader is
       doing with the page: a phone wants every pixel, a desktop wants a line short enough
       to track back from. */
    --measure: 44rem;
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    --fg: #e6e8ec;
    --muted: #98a1b0;
    --border: #2a2f38;
    --accent: #6aa8ff;
    --bg: #0e1014;
    color-scheme: dark;
  }

  :root[data-width='wide'] {
    --measure: 100%;
  }

  html {
    background: var(--bg);
  }

  * {
    box-sizing: border-box;
  }

  /*
   * The theme change is animated because a hard flip is jarring on a page this long. Only the
   * three properties that actually change are listed: a blanket `transition: all` would also
   * animate layout, which makes a page feel slower than it is.
   */
  html,
  html * {
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  body {
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
    max-width: var(--measure);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans Thai', sans-serif;
    line-height: 1.7;
    /* The width change animates too, so the reader can see which way the page moved. */
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      max-width 240ms ease;
  }

  /* A reader who has asked their system to stop moving things has asked us as well. */
  @media (prefers-reduced-motion: reduce) {
    html,
    html *,
    body {
      transition: none;
    }
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
  }

  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.9rem;
    min-height: 1.6rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    color: var(--muted);
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.5;
    padding: 0.1rem 0.5rem;
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--fg);
    border-color: var(--muted);
  }

  .toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .toggle .icon {
    display: block;
  }

  /*
   * The icon states what the click will do: expand while the page is at the reading width,
   * collapse while it is full. Chosen in CSS from `data-width` so the button is correct
   * before any script runs.
   *
   * The selectors carry `.toggle` so they outrank the `display: block` above — written as
   * plain `.icon-collapse` they would have lost to it, and both icons would have shown.
   */
  .toggle .icon-collapse,
  :root[data-width='wide'] .toggle .icon-expand {
    display: none;
  }

  :root[data-width='wide'] .toggle .icon-collapse {
    display: block;
  }

  a {
    color: var(--accent);
  }

  footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .muted {
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
    font-style: italic;
  }

  blockquote {
    margin: 0.5rem 0;
    padding-left: 0.75rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>

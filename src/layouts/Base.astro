---
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE.title ? title : `${title} · ${SITE.title}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      Both preferences are applied before the first paint, inline and before any stylesheet
      matters. Reading them after load would show every returning reader a flash of the wrong
      theme, which is the whole cost of having the toggle.
    -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        try {
          const theme = localStorage.getItem('ddb-theme');
          el.dataset.theme =
            theme ??
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const width = localStorage.getItem('ddb-width');
          if (width) el.dataset.width = width;
        } catch {
          // Private mode, or storage disabled. The defaults are already correct.
          el.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <header>
      <a href="/" class="brand">{SITE.title}</a>
      <nav>
        <a href="/about/">เกี่ยวกับ</a>
        <a href="/archive/">ฉบับก่อนหน้า</a>
        <a href="/rss.xml">RSS</a>
        <button
          id="theme-toggle"
          type="button"
          class="toggle"
          title="สลับโหมดสว่าง/มืด"
          aria-label="สลับโหมดสว่าง/มืด"
        ></button>
        <button
          id="width-toggle"
          type="button"
          class="toggle"
          title="ขยายความกว้างเนื้อหาให้เต็มจอ"
          aria-label="ขยายความกว้างเนื้อหาให้เต็มจอ"
          aria-pressed="false"></button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>สร้างโดย pipeline อัตโนมัติ · ทุกข้อกล่าวอ้างมีข้อความต้นทางและลิงก์กำกับ</p>
    </footer>

    <script is:inline>
      (() => {
        const el = document.documentElement;
        const themeButton = document.getElementById('theme-toggle');
        const widthButton = document.getElementById('width-toggle');

        // The labels state what the button will do next, not what is on now, so a reader who
        // cannot see the colours still knows which way the click goes.
        const paint = () => {
          if (themeButton) {
            const dark = el.dataset.theme === 'dark';
            themeButton.textContent = dark ? '☀️' : '🌙';
          }
          if (widthButton) {
            const wide = el.dataset.width === 'wide';
            widthButton.textContent = wide ? 'พอดี' : 'เต็มจอ';
            widthButton.setAttribute('aria-pressed', String(wide));
          }
        };

        const save = (key, value) => {
          try {
            localStorage.setItem(key, value);
          } catch {
            // A preference that cannot be saved is still worth honouring for this page.
          }
        };

        themeButton?.addEventListener('click', () => {
          el.dataset.theme = el.dataset.theme === 'dark' ? 'light' : 'dark';
          save('ddb-theme', el.dataset.theme);
          paint();
        });

        widthButton?.addEventListener('click', () => {
          el.dataset.width = el.dataset.width === 'wide' ? 'normal' : 'wide';
          save('ddb-width', el.dataset.width);
          paint();
        });

        paint();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fg: #16181d;
    --muted: #6b7280;
    --border: #e5e7eb;
    --accent: #1f6feb;
    --bg: #ffffff;
    /* The reading measure. A toggle, because the right width depends on what a reader is
       doing with the page: a phone wants every pixel, a desktop wants a line short enough
       to track back from. */
    --measure: 44rem;
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    --fg: #e6e8ec;
    --muted: #98a1b0;
    --border: #2a2f38;
    --accent: #6aa8ff;
    --bg: #0e1014;
    color-scheme: dark;
  }

  :root[data-width='wide'] {
    --measure: 100%;
  }

  html {
    background: var(--bg);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
    max-width: var(--measure);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans Thai', sans-serif;
    line-height: 1.7;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
  }

  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    color: var(--muted);
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.5;
    padding: 0.1rem 0.5rem;
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--fg);
    border-color: var(--muted);
  }

  .toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  a {
    color: var(--accent);
  }

  footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .muted {
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
    font-style: italic;
  }

  blockquote {
    margin: 0.5rem 0;
    padding-left: 0.75rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>

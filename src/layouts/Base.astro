---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Daily Dev Brief',
  description = 'สรุปวงการ dev รายวัน อ่านจบใน 10 นาที',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Daily Dev Brief' ? title : `${title} · Daily Dev Brief`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Daily Dev Brief" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a href="/" class="brand">Daily Dev Brief</a>
      <nav>
        <a href="/about/">เกี่ยวกับ</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>สร้างโดย pipeline อัตโนมัติ · ทุกข้อกล่าวอ้างมีข้อความต้นทางและลิงก์กำกับ</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --fg: #16181d;
    --muted: #6b7280;
    --border: #e5e7eb;
    --accent: #1f6feb;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
    max-width: 44rem;
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans Thai', sans-serif;
    line-height: 1.7;
  }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
  }
  nav a {
    margin-left: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  a {
    color: var(--accent);
  }
  footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .muted {
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }
  blockquote {
    margin: 0.5rem 0;
    padding-left: 0.75rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
